# Copy to .env and set a strong secret key before production deployment.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL connection. If DATABASE_URL is unset, local development uses SQLite.
DATABASE_URL=postgresql://fieldwell:change-me@localhost:5432/fieldwell

# Vite's development server proxies /api to this address.
API_PROXY_TARGET=http://127.0.0.1:8000
